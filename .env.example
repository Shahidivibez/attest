# ---- ATTEST configuration ----
# Copy to .env and fill in. NEVER commit .env.

# Server
PORT=3000

# zkVerify anchoring via Kurier.
# Without these the app runs in local mode: proofs verify locally but nothing
# is anchored on-chain, and the UI says so rather than pretending otherwise.
KURIER_API_KEY=
ATTEST_VK_HASH=

# Verification key hash of THIS circuit, printed by `npm run circuit:build`.
# Register it once on Kurier, then the platform can verify our proofs.
